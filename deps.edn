{:paths ["src" "target/classes"]
 :deps {org.clojure/clojure {:mvn/version "1.12.1"}}
 :aliases
 {:build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.9"}
          io.github.slipset/deps-deploy {:git/sha "07022b92d768590ab25b9ceb619ef17d2922da9a"}}
   :ns-default build}

  :test
  {:extra-paths ["test" "test-resources"]
   :extra-deps {metosin/jsonista {:mvn/version "0.3.13"}
                org.clojure/test.check {:mvn/version "1.1.1"}
                io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner"]
   :exec-fn cognitect.test-runner.api/test}

  :bench
  {:extra-paths ["bench"]
   :extra-deps {criterium/criterium {:mvn/version "0.4.6"}
                com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.6.2"}
                metosin/jsonista {:mvn/version "0.3.13"}
                cheshire/cheshire {:mvn/version "6.0.0"}}
   :jvm-opts ["-Djdk.attach.allowAttachSelf"
              "-XX:+UnlockDiagnosticVMOptions"
              "-XX:+DebugNonSafepoints"]}

  :nrepl
  {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
   :main-opts ["-m" "nrepl.cmdline"]}

  ;; opt-in SIMD scanning (combine: clj -M:test:vector, clj -M:bench:vector)
  :vector
  {:jvm-opts ["--add-modules" "jdk.incubator.vector"]}}}
